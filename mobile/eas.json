{
  "cli": {
    "version": ">= 18.1.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.13.0"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://sugarcheck-production.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.13.0",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://sugarcheck-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
