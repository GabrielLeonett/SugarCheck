engine-strict=false
confirmModulesPurge=false
# Mobile es la raíz de su propio workspace: permite que `expo install` añada
# dependencias sin exigir el flag -w en cada comando.
ignore-workspace-root-check=true
# node_modules plano (tipo npm) para que Metro/Expo resuelva todas las
# librerías sin depender de symlinks de pnpm.
node-linker=hoisted

ignore-workspace-root-check=true
