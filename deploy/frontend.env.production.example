# ============================================================
# SugarCheck - Frontend (Vite)
# install.sh copia este archivo a frontend/.env.production y
# reemplaza __DOMAIN__ por tu dominio.
#
# OJO: VITE_* se "hornea" en el build. Si cambias de dominio
# tienes que volver a ejecutar `pnpm build` en frontend/.
# ============================================================

VITE_BACKEND_URL=https://__DOMAIN__
