# ============================================================
# SugarCheck - Variables de entorno de PRODUCCIÓN
# install.sh copia este archivo a backend/.env.production y
# reemplaza __DOMAIN__ por tu dominio.
#
# Rellena los valores y vuelve a ejecutar install.sh.
# NUNCA subas el .env.production real al repositorio.
# ============================================================

# --- Servidor ---
NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# --- Base de datos (Supabase → Project Settings → Database) ---
# Runtime: pooler transaccional (puerto 6543)
DATABASE_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones: pooler de sesión (puerto 5432)
DIRECT_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres"

# --- Secretos (genera con: openssl rand -base64 48) ---
JWT_SECRET=""
RESET_TOKEN_SECRET=""

# --- Cookies ---
SAME_SITE=Lax
HTTPONLY=true
SECURE=true

# --- Dominio (sin slash final) ---
CORS_ORIGIN="https://__DOMAIN__"
FRONTEND_URL="https://__DOMAIN__"

# --- Email (Gmail SMTP con app password) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# --- Firebase Admin SDK ---
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_CLIENT_ID=""
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=""
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# --- IA del Oráculo (si queda vacía usa respuestas locales) ---
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.1-flash-lite
