datasource db {
  provider = "postgresql" 
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String      @id @default(uuid())
  name            String
  username        String      @unique
  password        String
  email           String?
  sexo            String
  roles           String[]
  createdAt       DateTime    @default(now())
  fechaNacimiento DateTime
  
  preference      Preference? 
  contactEmergences ContactEmergence[]
  imcRecords        Imc[]
}

model Preference {
  userId        String   @id
  profileImg    String   
  unitMeasure   String   
  sensitivity   Float   
  thresholds    Json     
  insulinRatios Json     

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContactEmergence {
  id          String   @id @default(uuid())
  userId      String
  name        String
  parentesco  String
  telefono    String?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Imc {
  id        String   @id @default(uuid())
  userId    String
  peso      Float
  altura    Float
  imcValue  Float
  fecha     DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}