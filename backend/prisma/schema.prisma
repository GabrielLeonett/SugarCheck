datasource db {
  provider = "postgresql" 
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String      @id @default(uuid())
  name            String
  password        String
  email           String      @unique
  roles           String[]
  createdAt       DateTime    @default(now())
  fechaNacimiento DateTime
  
  preference      Preference? 
}

model Preference {
  userId        String   @id 
  profileImg    String   @default("../../../assets/profile/GlucoAstro.png")
  unitMeasure   String
  thresholds    Json     
  insulinRatios Json
  sensitivity   Float    
  locale        String   @default("es")
  theme         String   @default("system")

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}