# ============================================================
# SugarCheck - Backend variables de entorno (plantilla)
# Copia este archivo como .env.development / .env.test / .env.production
# y completalo con tus valores. NUNCA commits los .env reales.
# ============================================================

# Servidor
NODE_ENV=development
PORT=3000
HOST=localhost

# Base de datos (Supabase: Project Settings -> Database -> Connection string)
# Pooled connection (runtime)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (migraciones con prisma migrate)
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# JWT
JWT_SECRET="cambia-por-una-clave-segura"
RESET_TOKEN_SECRET="cambia-por-otra-clave-segura"

# Cookies
SAME_SITE=Lax
HTTPONLY=true
SECURE=false

# CORS y frontend (separados por coma si hay varios origenes)
CORS_ORIGIN="http://localhost:5173,http://localhost:8081"
FRONTEND_URL="http://localhost:5173"

# Email (Gmail SMTP). Dejar vacio en dev para logs en consola
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Firebase Admin SDK
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=mi-proyecto
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com