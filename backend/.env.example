# ============================================================
# SugarCheck - Backend (plantilla)
#
# Local:   copia a .env.development y ajusta NODE_ENV/CORS.
# Servidor: copia a .env (Docker Compose lo inyecta con env_file).
#
# NUNCA subas el .env real al repositorio.
# ============================================================

# development | production
NODE_ENV=production

# Servidor
PORT=3000

# Base de datos (Supabase -> Project Settings -> Database)
# Runtime: pooler transaccional (puerto 6543)
DATABASE_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migraciones: pooler de sesión (puerto 5432)
DIRECT_URL="postgresql://postgres.<REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres"

# JWT (genera con: openssl rand -base64 48)
JWT_SECRET="<clave-segura>"

# CORS y frontend (varios orígenes separados por coma)
# Local: http://localhost:5173,http://localhost:8081
CORS_ORIGIN="https://sugarcheck.duckdns.org"
FRONTEND_URL="https://sugarcheck.duckdns.org"

# Email (Gmail SMTP). Opcional: si EMAIL_USER queda vacío, se usan logs.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM=""

# Firebase Admin SDK (solo estas tres variables se usan)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# IA del Oráculo (opcional; si GEMINI_API_KEY queda vacía usa respuestas locales)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.1-flash-lite
